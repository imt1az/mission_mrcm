APP_NAME="Mission MRCEM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.missionmrcem.com
FRONTEND_URL=https://missionmrcem.com
SANCTUM_STATEFUL_DOMAINS=missionmrcem.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.missionmrcem.com
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=warning
MAIL_MAILER=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS=hello@missionmrcem.com
MAIL_FROM_NAME="Mission MRCEM"

COURSE_CURRENCY=BDT
PAYMENT_INSTRUCTIONS="Set your real payment instructions in the administrator settings."
